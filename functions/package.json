{
  "name": "fundpath-functions",
  "description": "Cloud Functions for FundPath",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck:dev": "tsc -p tsconfig.dev.json",
    "serve": "yarn build && firebase emulators:start --only functions",
    "shell": "yarn build && firebase functions:shell",
    "start": "yarn shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev:sync": "tsx src/dev/run-sync.ts",
    "dev:coverage": "tsx src/dev/check-coverage.ts",
    "dev:cases": "tsx src/dev/run-cases.ts",
    "dev:kit": "tsx src/dev/run-kit.ts",
    "dev:sf424-fields": "tsx src/dev/map-sf424-fields.ts",
    "dev:notify": "tsx src/dev/send-test-notification.ts",
    "seed:export": "tsx src/dev/export-corpus.ts",
    "seed:restore": "tsx src/dev/restore-corpus.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "firebase-admin": "13.7.0",
    "firebase-functions": "6.3.2",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "4.19.2",
    "typescript": "^5.3.3",
    "vitest": "2.1.8"
  },
  "private": true
}
