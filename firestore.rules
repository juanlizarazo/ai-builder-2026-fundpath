rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /corpus/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /corpusMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /utahResources/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /demoRoutes/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /profiles/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == profileId;
    }

    match /routes/{routeId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /watches/{watchId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
